# Build artefacts
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
.pytest_cache/

# Python environments
*_venv/
.venv/
venv/

# Architecture-locked, must be rebuilt per device
.torchinductor_cache*/
*.plan
*.engine
*.trt
*.onnx
*.onnx_data
timing.cache
engines/

# Weights, calibration tensors and captured references: too large for git
*.pth
*.pt
*.ckpt
*.bin
*.safetensors
*.npz
!vla_accel/*/reference_results/**/*.npz
!vla_accel/*/reference_results/*.npz

# Local run output (the Orin copies to diff against are in vla_accel/*/reference_results/)
results/
*.csv
nohup.out
core
core.*

# Backups and patch leftovers
*.bak
*.bak-*
*.orig
*.rej
*~
*.swp

# Archives and installers
*.zip
*.tar
*.tar.gz
*.tar.xz
*.deb

# Editor, OS and tool state
.vscode/
.idea/
.claude/
.DS_Store
.env

# Bench output written by run.sh
vla_accel/*/out/
